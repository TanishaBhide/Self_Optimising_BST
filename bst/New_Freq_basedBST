// bst/freqBST.js
// Self-Optimizing BST with Hot-Cold Branch Reordering (Exact Methodology)

class FreqBSTNode {
  constructor(name) {
    this.key = name;        // contact name (string)
    this.left = null;
    this.right = null;
    
    // Left/Right access frequency counters
    this.leftFreq = 0;
    this.rightFreq = 0;
  }
}

export class FreqBST {
  constructor() {
    this.root = null;
    this.nodeVisits = 0;
    
    // Optimization parameters
    this.FREQ_THRESHOLD = 3;  // Minimum frequency difference for swap
  }

  /* ===============================  
     BASIC UTILITIES
     =============================== */
  resetVisits() {
    this.nodeVisits = 0;
  }

  /* ===============================  
     1. BST CONSTRUCTION (Standard Rules)
     =============================== */
  insert(name) {
    if (!name || typeof name !== "string") return;
    this.root = this._insert(this.root, name);
  }

  _insert(node, name) {
    if (!node) return new FreqBSTNode(name);

    const cmp = name.localeCompare(node.key);

    if (cmp < 0) {
      node.left = this._insert(node.left, name);
    } else if (cmp > 0) {
      node.right = this._insert(node.right, name);
    }
    // Duplicate names ignored (standard BST rule)

    return node;
  }

  /* ===============================  
     2. SEARCH WITH FREQUENCY TRACKING
     =============================== */
  search(name) {
    this.resetVisits();
    const found = this._search(this.root, name);
    
    // Trigger optimization after successful search
    if (found) {
      this.optimizeTree();
    }
    
    return found;
  }

  _search(node, name) {
    if (!node) return false;

    this.nodeVisits++;

    const cmp = name.localeCompare(node.key);

    if (cmp === 0) return true;  // Found exact match

    // 2. FREQUENCY TRACKING: Increment appropriate counter
    if (cmp < 0) {
      node.leftFreq++;           // Left child access
      return this._search(node.left, name);
    } else {
      node.rightFreq++;          // Right child access
      return this._search(node.right, name);
    }
  }

  /* ===============================  
     SEARCH WITH PATH (FOR VISUALIZATION)
     =============================== */
  searchWithPath(name) {
    this.resetVisits();
    const path = [];
    let node = this.root;

    while (node) {
      path.push(node.key);
      this.nodeVisits++;

      const cmp = name.localeCompare(node.key);

      if (cmp === 0) {
        // Trigger optimization
        this.optimizeTree();
        return path;
      }

      // 2. FREQUENCY TRACKING during path search
      if (cmp < 0) {
        node.leftFreq++;
        node = node.left;
      } else {
        node.rightFreq++;
        node = node.right;
      }
    }

    return path;
  }

  /* ===============================  
     3-4. HOT-COLD IDENTIFICATION & CHILD REORDERING
     =============================== */
  optimizeTree() {
    this._optimizeLocal(this.root);
  }

  _optimizeLocal(node) {
    if (!node) return;

    // 3. HOT-COLD BRANCH IDENTIFICATION
    const hotFreq = Math.max(node.leftFreq, node.rightFreq);
    const coldFreq = Math.min(node.leftFreq, node.rightFreq);
    const diff = hotFreq - coldFreq;

    // 4. SELF-OPTIMIZATION: Swap if hot branch significantly > cold branch
    if (diff >= this.FREQ_THRESHOLD) {
      // Hot branch (higher freq) becomes LEFT child (faster access in BSTs)
      if (node.rightFreq > node.leftFreq) {
        // Right is hot, Left is cold -> SWAP
        [node.left, node.right] = [node.right, node.left];
        [node.leftFreq, node.rightFreq] = [node.rightFreq, node.leftFreq];
      }
      // Note: Left already hot case requires no swap
    }

    // Recursively optimize children
    this._optimizeLocal(node.left);
    this._optimizeLocal(node.right);
  }

  /* ===============================  
     FORCE GLOBAL OPTIMIZATION
     =============================== */
  forceOptimize() {
    console.log("🔄 Global tree optimization triggered");
    this.optimizeTree();
  }

  /* ===============================  
     5. PERFORMANCE ANALYSIS
     =============================== */
  getPerformanceMetrics() {
    const metrics = {
      totalNodes: 0,
      totalFreq: 0,
      optimizedNodes: 0,
      optimizationRatio: 0
    };

    function analyze(node) {
      if (!node) return;

      metrics.totalNodes++;
      metrics.totalFreq += node.leftFreq + node.rightFreq;

      // Count nodes that would trigger optimization
      const diff = Math.abs(node.rightFreq - node.leftFreq);
      if (diff >= this.FREQ_THRESHOLD) {
        metrics.optimizedNodes++;
      }

      analyze(node.left);
      analyze(node.right);
    }.bind(this);

    analyze(this.root);
    metrics.optimizationRatio = metrics.totalNodes ? 
      (metrics.optimizedNodes / metrics.totalNodes) * 100 : 0;

    return metrics;
  }

  /* ===============================  
     DELETE (Preserves frequency data)
     =============================== */
  delete(name) {
    this.root = this._delete(this.root, name);
  }

  _delete(node, name) {
    if (!node) return null;

    const cmp = name.localeCompare(node.key);

    if (cmp < 0) {
      node.left = this._delete(node.left, name);
    } else if (cmp > 0) {
      node.right = this._delete(node.right, name);
    } else {
      if (!node.left) return node.right;
      if (!node.right) return node.left;

      const successor = this._minValueNode(node.right);
      node.key = successor.key;
      // Preserve successor's frequency data
      node.leftFreq = successor.leftFreq;
      node.rightFreq = successor.rightFreq;
      node.right = this._delete(node.right, successor.key);
    }

    return node;
  }

  _minValueNode(node) {
    while (node && node.left) node = node.left;
    return node;
  }

  /* ===============================  
     INORDER TRAVERSAL (Sorted order)
     =============================== */
  inorder() {
    const result = [];
    this._inorder(this.root, result);
    return result;
  }

  _inorder(node, result) {
    if (!node) return;
    this._inorder(node.left, result);
    result.push({
      key: node.key,
      leftFreq: node.leftFreq,
      rightFreq: node.rightFreq,
      balance: node.rightFreq - node.leftFreq
    });
    this._inorder(node.right, result);
  }

  /* ===============================  
     MENU-DRIVEN UTILITIES
     =============================== */
  printStats() {
    const metrics = this.getPerformanceMetrics();
    console.table(metrics);
    
    console.log("\n📊 Sample Node Frequencies:");
    const inorder = this.inorder().slice(0, 5);
    console.table(inorder.map(n => ({
      name: n.key,
      'L-Freq': n.leftFreq,
      'R-Freq': n.rightFreq,
      diff: n.balance
    })));
  }
}
